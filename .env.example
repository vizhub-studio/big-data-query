# VizHub Studio Project Configuration

# Required: Your VizHub Studio project ID
# You can find this in your VizHub Studio project URL: https://studio.vizhub.com/projects/:projectId
VIZHUB_PROJECT_ID=your-project-id-here

# Optional: Base URL for VizHub Studio API
# Defaults to https://studio.vizhub.com if not set
# Use this to point to a local development instance or alternative deployment
VIZHUB_BASE_URL=https://studio.vizhub.com
